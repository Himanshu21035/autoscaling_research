{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.4.2"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "MPC Autoscaler Research \u2014 Policy Comparison Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Replicas",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "autoscaler_replicas{policy=\"mpc\",forecaster=\"lstm\"}",
          "legendFormat": "MPC+LSTM",
          "refId": "A"
        },
        {
          "expr": "autoscaler_replicas{policy=\"hpa\",forecaster=\"none\"}",
          "legendFormat": "HPA",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current RPS",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "autoscaler_rps{policy=\"mpc\",forecaster=\"lstm\"}",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latency (ms)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "autoscaler_latency_ms{policy=\"mpc\",forecaster=\"lstm\"}",
          "legendFormat": "MPC+LSTM",
          "refId": "A"
        },
        {
          "expr": "autoscaler_latency_ms{policy=\"hpa\",forecaster=\"none\"}",
          "legendFormat": "HPA",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "SLA Violated",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                },
                "1": {
                  "text": "VIOLATED",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "autoscaler_sla_violated{policy=\"mpc\",forecaster=\"lstm\"}",
          "legendFormat": "MPC+LSTM",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Replicas Over Time \u2014 Policy Comparison",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "HPA (baseline)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    4,
                    4
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#aaa"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "autoscaler_replicas{policy=\"mpc\",forecaster=\"lstm\"}",
          "legendFormat": "MPC + LSTM",
          "refId": "A"
        },
        {
          "expr": "autoscaler_replicas{policy=\"mpc\",forecaster=\"arima\"}",
          "legendFormat": "MPC + ARIMA",
          "refId": "B"
        },
        {
          "expr": "autoscaler_replicas{policy=\"mpc\",forecaster=\"prophet\"}",
          "legendFormat": "MPC + Prophet",
          "refId": "C"
        },
        {
          "expr": "autoscaler_replicas{policy=\"hpa\",forecaster=\"none\"}",
          "legendFormat": "HPA (baseline)",
          "refId": "D"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "RPS vs Capacity",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Capacity (MPC+LSTM)"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    6,
                    3
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "autoscaler_rps{policy=\"mpc\",forecaster=\"lstm\"}",
          "legendFormat": "RPS",
          "refId": "A"
        },
        {
          "expr": "autoscaler_replicas{policy=\"mpc\",forecaster=\"lstm\"} * on() group_left() autoscaler_replicas{policy=\"mpc\",forecaster=\"lstm\"} * 100",
          "legendFormat": "Capacity (MPC+LSTM)",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Latency Comparison",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SLA Threshold"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    8,
                    4
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "autoscaler_latency_ms{policy=\"mpc\",forecaster=\"lstm\"}",
          "legendFormat": "MPC+LSTM",
          "refId": "A"
        },
        {
          "expr": "autoscaler_latency_ms{policy=\"mpc\",forecaster=\"arima\"}",
          "legendFormat": "MPC+ARIMA",
          "refId": "B"
        },
        {
          "expr": "autoscaler_latency_ms{policy=\"hpa\",forecaster=\"none\"}",
          "legendFormat": "HPA",
          "refId": "C"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "ADAPT Cold-Start Estimate (s)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "expr": "autoscaler_adapt_estimate_s{policy=\"mpc\",forecaster=\"lstm\"}",
          "legendFormat": "ADAPT estimate",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Capacity Utilisation",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1.2,
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "autoscaler_utilisation{policy=\"mpc\",forecaster=\"lstm\"}",
          "legendFormat": "MPC+LSTM",
          "refId": "A"
        },
        {
          "expr": "autoscaler_utilisation{policy=\"hpa\",forecaster=\"none\"}",
          "legendFormat": "HPA",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 20,
      "type": "bargauge",
      "title": "SLA Violation % \u2014 All Policies",
      "description": "From completed run summaries. Always populated after runs complete.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "autoscaler_sla_pct{policy=\"mpc\",forecaster=\"lstm\"}",
          "legendFormat": "MPC+LSTM",
          "refId": "A"
        },
        {
          "expr": "autoscaler_sla_pct{policy=\"mpc\",forecaster=\"arima\"}",
          "legendFormat": "MPC+ARIMA",
          "refId": "B"
        },
        {
          "expr": "autoscaler_sla_pct{policy=\"mpc\",forecaster=\"prophet\"}",
          "legendFormat": "MPC+Prophet",
          "refId": "C"
        },
        {
          "expr": "autoscaler_sla_pct{policy=\"hpa\",forecaster=\"none\"}",
          "legendFormat": "HPA (baseline)",
          "refId": "D"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 21,
      "type": "bargauge",
      "title": "Average Replicas \u2014 All Policies",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "autoscaler_avg_replicas{policy=\"mpc\",forecaster=\"lstm\"}",
          "legendFormat": "MPC+LSTM",
          "refId": "A"
        },
        {
          "expr": "autoscaler_avg_replicas{policy=\"mpc\",forecaster=\"arima\"}",
          "legendFormat": "MPC+ARIMA",
          "refId": "B"
        },
        {
          "expr": "autoscaler_avg_replicas{policy=\"hpa\",forecaster=\"none\"}",
          "legendFormat": "HPA (baseline)",
          "refId": "C"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "autoscaler",
    "mpc",
    "research"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource",
        "label": "Prometheus"
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Autoscaler Research \u2014 Policy Comparison",
  "uid": "autoscaler-research-v1",
  "version": 2
}